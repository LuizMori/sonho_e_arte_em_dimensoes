# Copie este arquivo para .env.local (uso local com `vercel dev`) e preencha os valores.
# Em produção, configure as mesmas variáveis em Vercel > Settings > Environment Variables.

# Chave de API do Resend (https://resend.com), usada para enviar o e-mail de orçamento.
# Requer o domínio sonhoearte3d.com.br verificado em Resend > Domains.
RESEND_API_KEY=

# E-mail que deve receber os pedidos de orçamento (ex: contato@sonhoearte3d.com.br).
CONTACT_EMAIL=

# URL e chave anônima do projeto Supabase (Project Settings > API). Usadas no frontend (auth, produtos).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave de service role do Supabase (Project Settings > API). Usada só em funções serverless
# (nunca exponha no frontend), quando for necessário ignorar RLS a partir do backend.
SUPABASE_SERVICE_ROLE_KEY=

# Token de acesso pessoal do Melhor Envio (https://melhorenvio.com.br > Gerar token), usado para
# cotação de frete. Use um token de sandbox (https://sandbox.melhorenvio.com.br) para testes.
MELHOR_ENVIO_TOKEN=

# CEP de origem dos envios (endereço do estúdio), sem traço. Ex: 01001000
CEP_ORIGEM=

# Opcional: URL da API de cálculo de frete do Melhor Envio. Deixe em branco para usar a de produção.
# Para testar com token de sandbox, use https://sandbox.melhorenvio.com.br/api/v2/me/shipment/calculate
MELHOR_ENVIO_API_URL=

# Access token do Mercado Pago (Suas integrações > Credenciais). Use um token de teste (TEST-...)
# para testar sem cobrar de verdade; troque pelo de produção quando for para o ar.
MP_ACCESS_TOKEN=

# Chave secreta usada para validar a assinatura (x-signature) dos webhooks do Mercado Pago
# (Suas integrações > Webhooks > Assinatura secreta).
MP_WEBHOOK_SECRET=
